# Скопируйте в .env.local и заполните. .env.local не коммитится.

# Ключ OpenAI — только на сервере
OPENAI_API_KEY=

# Модели (необязательно — по умолчанию самые дешёвые подходящие)
# OPENAI_MODEL_TUTOR=gpt-5.4-mini
# OPENAI_MODEL_VISION=gpt-5.4-mini
# OPENAI_MODEL_FAST=gpt-5.4-nano

# Озвучка видео (scripts/generate-voiceover.mts)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral

# ---------- Потолок расходов ИИ на сервере (решение #48) ----------
# Все значения необязательны: пусто или не число > 0 — берётся значение по умолчанию (в комментарии).
# Лимиты считаются в «обращениях» за сутки по Астане: обычный вопрос = 1, фото = 2, голос = 4.

# Секрет подписи cookie устройства (inf_ai). Любая длинная случайная строка.
# Нет — берётся производная от OPENAI_API_KEY; нет и её — в production случайная на процесс (cookie тогда живут до перезапуска).
# AI_DEVICE_SECRET=

# Обращений в сутки на одно устройство (по умолчанию 65 — общий потолок всех тарифов, AI_DAILY_CAP в lib/economy.ts)
# AI_DEVICE_DAILY_UNITS=
# Обращений в сутки на один IP — класс или семья за одним адресом (по умолчанию 1000)
# AI_IP_DAILY_UNITS=
# Обращений в сутки на весь сайт — общий бюджет; сверх него ИИ отвечает «закончился запас на сегодня» (по умолчанию 3000)
# AI_SITE_DAILY_UNITS=
# Новых устройств в сутки с одного IP (IPv6 — с сети /64) — защита от обхода через удаление cookie; школьный Wi-Fi и мобильные операторы дают много учеников на один адрес (по умолчанию 300)
# AI_NEW_DEVICES_PER_IP=
# Бесплатных для устройства запросов в сутки — отзыв после урока (по умолчанию 30)
# AI_FREE_DEVICE_DAILY=

# ---------- Общее хранилище счётчиков и жалоб (Upstash Redis) ----------
# Нужно, чтобы лимиты и жалобы были общими для всех копий сервера на Vercel.
# Без него счётчики живут в памяти каждой копии отдельно — это только мягкая защита.
# Подключается через Vercel Marketplace (Upstash) — тогда переменные KV_REST_API_* появляются сами; или вручную:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Те же значения под именами Vercel Marketplace (если заданы UPSTASH_*, берутся они):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- Статистика для нас и страница владельца (решение #69) ----------
# Обезличенная статистика: какие уроки проходят, где бросают, какие задания трудные, спрос на тарифы, удержание.
# Без имени, id устройства и IP; в хранилище только суточные счётчики. Страница с цифрами — /owner.
# Счётчики и жалобы лежат в Upstash (см. выше): без него у каждой копии сервера своя память, и страница покажет только её кусок.

# Сбор статистики. Пусто (по умолчанию) — выключен: приложение ничего не отправляет, /api/events отвечает 204 и ничего не пишет.
# 1 — включён (ученик может выключить в профиле). Включать ТОЛЬКО после обновления политики конфиденциальности:
# сейчас в ней написано «не ставим счётчики посещений», и мы обещали сообщить заранее.
# Переменная NEXT_PUBLIC_*: подставляется при сборке, после смены нужна новая сборка (redeploy).
# NEXT_PUBLIC_ANALYTICS=

# Пароль страницы владельца /owner. Любая длинная случайная строка, не короче 12 знаков.
# Нет (или короче) — страница и вход отвечают 404, как будто их нет. Сменили пароль — все прежние входы (cookie на 12 часов) перестают действовать.
# OWNER_SECRET=

# ---------- Сайт ----------
# Адрес сайта для превью ссылки в мессенджерах (Open Graph) и правовых страниц.
# По умолчанию https://informatica-chi.vercel.app. Задайте, если сайт на своём домене.
# NEXT_PUBLIC_SITE_URL=
